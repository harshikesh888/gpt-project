# Copy to .env and fill in the API key. Never commit real secrets.

# --- Branding ---------------------------------------------------------------
APP_NAME=Jarvis AI
APP_VERSION=2.0.0
ENVIRONMENT=production

# --- Required ---------------------------------------------------------------
# Local Ollama does not need an API key. The Hugging Face key below is unused
# while LLM_BASE_URL points at Ollama; uncomment it to switch back to HF.
LLM_BASE_URL=http://localhost:11434/v1
# Only needed for remote or authenticated OpenAI-compatible backends.
# LLM_API_KEY=
# HF_API_KEY=

# --- Models -----------------------------------------------------------------
# `ollama list` shows the models installed on this machine.
FAST_MODEL=qwen2.5-coder:7b
DEEP_MODEL=qwen2.5-coder:7b
# Ollama has no router-provider concept; leave empty.
PROVIDER=
# Optional model tried before the mode's alternate model when the primary fails.
# FALLBACK_MODEL=

# --- Upstream tuning --------------------------------------------------------
# Local models can be slow to load on the first request, so allow a long read.
FAST_MAX_TOKENS=700
DEEP_MAX_TOKENS=1500
FAST_TEMPERATURE=0.5
DEEP_TEMPERATURE=0.6
CONNECT_TIMEOUT=10
READ_TIMEOUT=300
WRITE_TIMEOUT=30
POOL_TIMEOUT=5

# Ollama's default context is small. Start the server with a larger window if
# long conversations get truncated: OLLAMA_CONTEXT_LENGTH=8192 ollama serve

# --- Public limits ----------------------------------------------------------
MAX_MESSAGE_CHARS=4000
MAX_HISTORY_MESSAGES=12
MAX_HISTORY_CHARS=12000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=20000
MAX_CONCURRENT_STREAMS=32
CONCURRENCY_WAIT_SECONDS=2
REQUEST_BODY_LIMIT=65536

# --- Caching ----------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=256
CACHE_MAX_CHARS=6000

# --- Deployment -------------------------------------------------------------
# Set to true only when the app is behind a trusted reverse proxy (Azure,
# Heroku, Render, Cloudflare, nginx) that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# ALLOWED_ORIGINS=https://example.com

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
DOCS_ENABLED=true
STATS_ENABLED=false
# STATS_ENABLED exposes counters at /api/stats (no prompt content is included).
